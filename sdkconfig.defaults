# ---- flash / partitions ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- OTA safety: new firmware must prove itself or the bootloader rolls back ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- size ----
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y

# ---- HTTP server ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# ---- HTTP client: GitHub release redirects carry very long URLs ----
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# ---- lwIP ----
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_RAW=y
# IPv6: get a global address by SLAAC where the network has one, so the DNS
# server can be offered as the IPv6 resolver too.
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
# Lease table of the DHCP servers (setup AP, optional home-network server).
# Past this many clients lwIP silently drops the oldest lease and may hand
# its address out twice; LanDhcp caps the pool at this size. Heap only, and
# only for clients that actually got a lease (~90 bytes each).
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=64
# Datagrams queued per UDP socket (IDF default 6). A page load sends 20-50
# lookups at once; past the queue lwIP drops them and clients retry after ~1 s.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# ---- tasks ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# Wi-Fi/IP event handlers run here (AP policy, reconnect, logging): 2304 is tight.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000
