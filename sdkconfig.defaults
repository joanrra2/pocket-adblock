# ---- flash / partitions ----
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- OTA safety: new firmware must prove itself or the bootloader rolls back ----
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- size ----
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# Unused here (home Wi-Fi, HTTPS/MQTT clients only): enterprise Wi-Fi, OWE open
# networks, WPA3 on the setup AP, rare TLS curves and X.509 extras. WPA3 for
# joining the home network stays. Keeps the 4 MB ESP32-C6 image in its slot.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_SOFTAP=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_X509_CRL_PARSE_C=n
# MQTT over mqtt:// and mqtts:// (the UI suggests mqtts://), not WebSockets.
# mDNS only announces this device (sinkhole.local + _http._tcp): no browsing,
# console commands or several instances of one service.
CONFIG_MQTT_TRANSPORT_WEBSOCKET=n
CONFIG_MDNS_ENABLE_BROWSE=n
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_MULTIPLE_INSTANCE=n
CONFIG_MBEDTLS_X509_CSR_PARSE_C=n
CONFIG_MBEDTLS_PEM_WRITE_C=n
CONFIG_MBEDTLS_PKCS7_C=n
CONFIG_MBEDTLS_SSL_RENEGOTIATION=n
CONFIG_MBEDTLS_KEY_EXCHANGE_RSA=n

# ---- HTTP server ----
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512

# ---- HTTP client: GitHub release redirects carry very long URLs ----
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# ---- lwIP ----
# Worst case with every Pro feature on is 18: web server 7 (listen, control,
# 5 sessions), DNS 3, DNS over TLS 2, MQTT 1, notifications 3, updater 1,
# Wake-on-LAN probe 1. A failed socket() would read as "host offline".
CONFIG_LWIP_MAX_SOCKETS=20
CONFIG_LWIP_RAW=y
# IPv6: get a global address by SLAAC where the network has one, so the DNS
# server can be offered as the IPv6 resolver too.
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_IPV6_AUTOCONFIG=y
# Lease table of the DHCP servers (setup AP, optional home-network server).
# Past this many clients lwIP silently drops the oldest lease and may hand
# its address out twice; LanDhcp caps the pool at this size. Heap only, and
# only for clients that actually got a lease (~90 bytes each).
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=64
# sendto/recvfrom run lwIP directly under a lock instead of messaging the
# tcpip task and waiting for it (two context switches per call).
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
# Datagrams queued per UDP socket (IDF default 6). A page load sends 20-50
# lookups at once; past the queue lwIP drops them and clients retry after ~1 s.
CONFIG_LWIP_UDP_RECVMBOX_SIZE=32

# ---- tasks ----
# Only during boot: app_main returns and the task (with its stack) goes away.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120
# Wi-Fi/IP event handlers run here (AP policy, reconnect, logging): 2304 is tight.
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000
